{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "vitest/globals", "node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["app/**/*.ts", "tests/**/*.ts"]
}
